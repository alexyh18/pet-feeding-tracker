<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header"
            android:textColor="@color/pink_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to log a feeding · tap a name to rename"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="14dp" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 0 -->
            <LinearLayout
                android:id="@+id/card_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/badge_0" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="@string/fed_today" android:textColor="@color/white"
                    android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/badge_bg" android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp" android:visibility="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🐶" android:textSize="34sp" android:gravity="center" />

                <EditText android:id="@+id/name_0" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Pet 1"
                    android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center" android:background="@android:color/transparent"
                    android:maxLength="18" android:inputType="text" android:imeOptions="actionDone" />

                <Button android:id="@+id/feed_0" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/feed"
                    android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                    android:background="@drawable/feed_button" android:layout_marginTop="6dp"
                    android:paddingVertical="14dp" />

                <TextView android:id="@+id/last_0" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Not fed yet"
                    android:textColor="@color/text_soft" android:textSize="12sp"
                    android:gravity="center" android:layout_marginTop="8dp" android:minLines="2" />

                <Button android:id="@+id/hist_0" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="View History (0)"
                    android:textColor="@color/pink_dark" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/hist_button" android:layout_marginTop="6dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <!-- Card 1 -->
            <LinearLayout
                android:id="@+id/card_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/badge_1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="@string/fed_today" android:textColor="@color/white"
                    android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/badge_bg" android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp" android:visibility="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🐱" android:textSize="34sp" android:gravity="center" />

                <EditText android:id="@+id/name_1" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Pet 2"
                    android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center" android:background="@android:color/transparent"
                    android:maxLength="18" android:inputType="text" android:imeOptions="actionDone" />

                <Button android:id="@+id/feed_1" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/feed"
                    android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                    android:background="@drawable/feed_button" android:layout_marginTop="6dp"
                    android:paddingVertical="14dp" />

                <TextView android:id="@+id/last_1" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Not fed yet"
                    android:textColor="@color/text_soft" android:textSize="12sp"
                    android:gravity="center" android:layout_marginTop="8dp" android:minLines="2" />

                <Button android:id="@+id/hist_1" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="View History (0)"
                    android:textColor="@color/pink_dark" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/hist_button" android:layout_marginTop="6dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 2 -->
            <LinearLayout
                android:id="@+id/card_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/badge_2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="@string/fed_today" android:textColor="@color/white"
                    android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/badge_bg" android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp" android:visibility="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🐰" android:textSize="34sp" android:gravity="center" />

                <EditText android:id="@+id/name_2" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Pet 3"
                    android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center" android:background="@android:color/transparent"
                    android:maxLength="18" android:inputType="text" android:imeOptions="actionDone" />

                <Button android:id="@+id/feed_2" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/feed"
                    android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                    android:background="@drawable/feed_button" android:layout_marginTop="6dp"
                    android:paddingVertical="14dp" />

                <TextView android:id="@+id/last_2" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Not fed yet"
                    android:textColor="@color/text_soft" android:textSize="12sp"
                    android:gravity="center" android:layout_marginTop="8dp" android:minLines="2" />

                <Button android:id="@+id/hist_2" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="View History (0)"
                    android:textColor="@color/pink_dark" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/hist_button" android:layout_marginTop="6dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <!-- Card 3 -->
            <LinearLayout
                android:id="@+id/card_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="7dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/badge_3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="@string/fed_today" android:textColor="@color/white"
                    android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/badge_bg" android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp" android:visibility="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🐹" android:textSize="34sp" android:gravity="center" />

                <EditText android:id="@+id/name_3" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Pet 4"
                    android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center" android:background="@android:color/transparent"
                    android:maxLength="18" android:inputType="text" android:imeOptions="actionDone" />

                <Button android:id="@+id/feed_3" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/feed"
                    android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                    android:background="@drawable/feed_button" android:layout_marginTop="6dp"
                    android:paddingVertical="14dp" />

                <TextView android:id="@+id/last_3" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Not fed yet"
                    android:textColor="@color/text_soft" android:textSize="12sp"
                    android:gravity="center" android:layout_marginTop="8dp" android:minLines="2" />

                <Button android:id="@+id/hist_3" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="View History (0)"
                    android:textColor="@color/pink_dark" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/hist_button" android:layout_marginTop="6dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
