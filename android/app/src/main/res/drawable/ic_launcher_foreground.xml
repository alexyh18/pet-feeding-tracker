<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Crested gecko face, inspired by the provided artwork: a rounded orange head,
      "eyelash" crest bumps, two large dark eyes, and a friendly smile.
      Kept within the ~66dp adaptive-icon safe zone (roughly x/y 21..87).
    -->
    <group android:name="gecko">

        <!-- Head base (rounded, slightly wider than tall) -->
        <path android:fillColor="#F2A003"
            android:pathData="M54,30
                C70,30 84,41 84,56
                C84,70 71,80 54,80
                C37,80 24,70 24,56
                C24,41 38,30 54,30 Z" />

        <!-- Darker outline ring for depth -->
        <path android:strokeColor="#C87E00" android:strokeWidth="2.5"
            android:fillColor="#00000000"
            android:pathData="M54,30
                C70,30 84,41 84,56
                C84,70 71,80 54,80
                C37,80 24,70 24,56
                C24,41 38,30 54,30 Z" />

        <!-- Left eyelash crest bumps -->
        <path android:fillColor="#E59400"
            android:pathData="M30,42 c2,-5 7,-7 11,-5 c-3,1 -5,3 -6,6 c-2,-2 -4,-2 -5,-1 Z" />
        <path android:fillColor="#E59400"
            android:pathData="M38,38 c2,-4 6,-6 10,-4 c-3,1 -5,3 -6,5 c-1,-2 -3,-2 -4,-1 Z" />
        <!-- Right eyelash crest bumps -->
        <path android:fillColor="#E59400"
            android:pathData="M78,42 c-2,-5 -7,-7 -11,-5 c3,1 5,3 6,6 c2,-2 4,-2 5,-1 Z" />
        <path android:fillColor="#E59400"
            android:pathData="M70,38 c-2,-4 -6,-6 -10,-4 c3,1 5,3 6,5 c1,-2 3,-2 4,-1 Z" />

        <!-- Speckles / texture -->
        <path android:fillColor="#D98B00" android:pathData="M46,66 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0" />
        <path android:fillColor="#D98B00" android:pathData="M62,66 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0" />
        <path android:fillColor="#D98B00" android:pathData="M54,70 m-1.4,0 a1.4,1.4 0 1,1 2.8,0 a1.4,1.4 0 1,1 -2.8,0" />

        <!-- Eyes (large, dark) -->
        <path android:fillColor="#2B2117" android:pathData="M43,52 m-8,0 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0" />
        <path android:fillColor="#2B2117" android:pathData="M65,52 m-8,0 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0" />
        <!-- Eye highlights -->
        <path android:fillColor="#FFFFFF" android:pathData="M40,49 m-2.4,0 a2.4,2.4 0 1,1 4.8,0 a2.4,2.4 0 1,1 -4.8,0" />
        <path android:fillColor="#FFFFFF" android:pathData="M62,49 m-2.4,0 a2.4,2.4 0 1,1 4.8,0 a2.4,2.4 0 1,1 -4.8,0" />

        <!-- Smile -->
        <path android:strokeColor="#5A3B00" android:strokeWidth="3"
            android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M44,70 Q54,78 64,70" />
    </group>
</vector>
